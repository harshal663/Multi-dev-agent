# Copy to backend/.env for local (non-Docker) runs, or export these directly.
# All backend settings are read with the MIO_ prefix — see backend/app/config.py

MIO_ANTHROPIC_API_KEY=sk-ant-...

MIO_ARCHITECT_MODEL=claude-sonnet-4-6
MIO_CODER_MODEL=claude-sonnet-4-6
MIO_REVIEWER_MODEL=claude-sonnet-4-6
MIO_QA_MODEL=claude-sonnet-4-6

MIO_REDIS_URL=redis://localhost:6379/0

MIO_DOCKER_SANDBOX_IMAGE=mio-sandbox-python:latest
MIO_SANDBOX_TIMEOUT_SECONDS=30

MIO_MAX_REVIEW_CYCLES=3
